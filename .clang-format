BasedOnStyle: LLVM
AllowShortFunctionsOnASingleLine: Empty
BraceWrapping:
  AfterFunction: true
BreakBeforeBraces: Custom
ColumnLimit: 110
InsertBraces: true
InsertNewlineAtEOF: true
ReflowComments: false # comment text is never reflowed: StrictDoc's @relation markers must stay on one line
SeparateDefinitionBlocks: Always
